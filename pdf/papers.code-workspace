{
  "folders": [{"path": "."}],
  "settings": {
    "latex-workshop.latex.tools": [{
      "name": "pdflatex-direct",
      "command": "pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "-aux-directory=%DIR%/build", "-output-directory=%DIR%", "%DOC%"]
    }],
    "latex-workshop.latex.recipes": [{"name": "pdfLaTeX (twice)", "tools": ["pdflatex-direct", "pdflatex-direct"]}],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.view.pdf.viewer": "tab"
  }
}
